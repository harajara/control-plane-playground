# Generated by task setup. Keep .env private; these placeholders are not real values.
# Setup fills any missing entry once and never rewrites an existing one, so the
# Postgres volumes, the signing key and already-sealed commands stay consistent.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
CP_DB_PASSWORD=GENERATE_CP_DB_PASSWORD
TENANT_DB_PASSWORD=GENERATE_TENANT_DB_PASSWORD
# 32-byte HMAC key, base64. Signs every Kafka envelope (task commands,
# results, heartbeats). Deterministic across restarts by design.
M2M_SECRET=GENERATE_M2M_SECRET
# NaCl box keypair, hex. The control plane seals an imported database URL to
# CONTROL_PLANE_RECEIVE_KEY; only the holder of WORKER_SEAL_KEY can open it.
WORKER_SEAL_KEY=GENERATE_WORKER_SEAL_KEY
CONTROL_PLANE_RECEIVE_KEY=GENERATE_CONTROL_PLANE_RECEIVE_KEY
# Scenario knobs. WORKER_FAIL_RATE=1 makes every provisioning attempt fail.
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
# CP_FAST_PUBLISH=false disables only the in-request publish so the five-second
# sweeper becomes deterministic. COOKIE_SECURE=true behind TLS.
CP_FAST_PUBLISH=true
COOKIE_SECURE=false
# info (default) | debug | warn | error
CP_LOG_LEVEL=info
